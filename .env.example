# Safe placeholder values for local development only.
# Copy to .env for local development, then replace placeholders locally.

APP_ENV=local
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

POSTGRES_USER=app_user_placeholder
POSTGRES_PASSWORD=postgres_password_placeholder
POSTGRES_DB=agentic_x_clone
POSTGRES_HOST_PORT=5432
# Use 8001 locally because 8000 is often occupied by adjacent local services.
BACKEND_HOST_PORT=8001
FRONTEND_HOST_PORT=3000
DATABASE_URL=postgresql+psycopg://app_user_placeholder:postgres_password_placeholder@localhost:5432/agentic_x_clone

BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
# Set ENABLE_API_DOCS=false in any exposed demo backend deployment.
ENABLE_API_DOCS=true
# public/local allows API-scoped synthetic mutations; EKS public backend sets read_only.
MUTATION_API_MODE=public
VITE_API_BASE_URL=http://127.0.0.1:8001
XCLONE_API_BASE_URL=http://127.0.0.1:8001

XCLONE_AGENT_ALEX_TOKEN=agent_alex_fixture_token_placeholder
XCLONE_AGENT_MIRA_TOKEN=agent_mira_fixture_token_placeholder
XCLONE_HARNESS_TOKEN=harness_fixture_token_placeholder
SIGNUP_MAX_DYNAMIC_AGENTS=50
V2_CURSOR_SIGNING_KEY=cursor_signing_key_placeholder
V2_CURSOR_DEFAULT_LIMIT=25
V2_CURSOR_MAX_LIMIT=100
V2_CURSOR_TTL_SECONDS=86400
V2_CLIENT_REQUEST_ID_MAX_LENGTH=120
V2_IDEMPOTENCY_TTL_SECONDS=86400

AI_PROVIDER=disabled
AI_API_KEY=not_used_in_scaffold

# V2 AI activity runner defaults for small recurring live synthetic bursts.
# Leave AI_ACTIVITY_RUN_ID blank to auto-generate a unique public-safe run id.
# Replace AI_ACTIVITY_LLM_API_KEY only in your ignored local .env; do not commit it.
# For cron, replace the placeholder API URL in ignored config with the tailnet-only backend operator URL.
AI_ACTIVITY_API_BASE_URL=http://xclone-backend-operator-tailnet.example.ts.net:8000
AI_ACTIVITY_RUNNER_MODE=synthetic_load
AI_ACTIVITY_AGENT_COUNT=4
AI_ACTIVITY_SIGNUP_MODE=reuse_or_create
AI_ACTIVITY_OUTPUT_DIR=.hermes/tmp/ai-activity-runner
AI_ACTIVITY_STATE_DIR=.hermes/tmp/ai-activity-runner/state
AI_ACTIVITY_STATE_ROTATION=true
AI_ACTIVITY_RUN_ID=
AI_ACTIVITY_LLM_PROVIDER=local_codex_bridge
AI_ACTIVITY_LLM_BASE_URL=http://127.0.0.1:4000/v1
AI_ACTIVITY_LLM_API_KEY=bridge_local_key_placeholder
AI_ACTIVITY_LLM_MODEL=gpt-5.4-mini
AI_ACTIVITY_LLM_TIMEOUT_SECONDS=45
AI_ACTIVITY_LLM_MAX_RETRIES=1
AI_ACTIVITY_LLM_TEMPERATURE=0.8
AI_ACTIVITY_LLM_RESPONSE_BUDGET=500
AI_ACTIVITY_MAX_STEPS=24
AI_ACTIVITY_MAX_WALL_SECONDS=360
AI_ACTIVITY_CONCURRENCY=1
AI_ACTIVITY_RANDOM_SEED=42
AI_ACTIVITY_MAX_CONVERSATION_TURNS=4
AI_ACTIVITY_REPLIES_FIRST=true
AI_ACTIVITY_TARGET_COOLDOWN_STEPS=6
AI_ACTIVITY_RECENT_ACTION_WINDOW=12
AI_ACTIVITY_MAX_REPLY_SHARE=0.45
AI_ACTIVITY_SPICY_STYLE=true
AI_ACTIVITY_SILLINESS_LEVEL=1.0
AI_ACTIVITY_CHAOS_LEVEL=0.35
AI_ACTIVITY_STYLE_PACK=car_forum_gremlins
AI_ACTIVITY_STYLE_PACK_POOL=car_forum_gremlins,marketplace_menace,spreadsheet_goblins,auction_lot_cryptids
AI_ACTIVITY_REDACT_ARTIFACTS=true
AI_ACTIVITY_LIVE_LLM_SMOKE=0

# Optional host cron wrapper controls. Keep the referenced env file ignored/private.
AI_ACTIVITY_CRON_ENV_FILE=.hermes/private/ai-activity-runner.env
AI_ACTIVITY_CRON_LOCK_FILE=.hermes/tmp/ai-activity-runner/cron.lock
AI_ACTIVITY_CRON_LOG_FILE=.hermes/tmp/ai-activity-runner/logs/cron.log
AI_ACTIVITY_CRON_PYTHON=python3
AI_ACTIVITY_CRON_RUNNER_CMD=scripts/ai_activity_runner.py
AI_ACTIVITY_CRON_TIMEOUT_SECONDS=420

# Temporary AWS demo operations defaults. These are placeholders for local shell use;
# receipts are written under .hermes/tmp and should not be committed raw.
AWS_REGION=us-east-1
CLUSTER_NAME=xclone-demo
NAMESPACE=xclone
FRONTEND_URL=https://xclone.example.com
API_URL=https://api.xclone.example.com
PROJECT_TAG_VALUE=x-clone
ENVIRONMENT_TAG_VALUE=demo
TF_DIR=infra/aws-demo/terraform
RECEIPT_DIR=.hermes/tmp/aws-demo-receipts
ALB_LOG_BUCKET=
ALB_LOG_PREFIX=alb/xclone-demo
DESTROY_APPROVAL=dry-run
