# Safe placeholder values for local development only.
# Copy to .env for local development, then replace placeholders locally.

APP_ENV=local
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

POSTGRES_USER=app_user_placeholder
POSTGRES_PASSWORD=postgres_password_placeholder
POSTGRES_DB=agentic_x_clone
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
DATABASE_URL=postgresql+psycopg://app_user_placeholder:postgres_password_placeholder@localhost:5432/agentic_x_clone

BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
XCLONE_API_BASE_URL=http://localhost:8000

XCLONE_AGENT_ALEX_TOKEN=agent_alex_fixture_token_placeholder
XCLONE_AGENT_MIRA_TOKEN=agent_mira_fixture_token_placeholder
XCLONE_HARNESS_TOKEN=harness_fixture_token_placeholder
SIGNUP_MAX_DYNAMIC_AGENTS=50
V2_CURSOR_SIGNING_KEY=cursor_signing_key_placeholder
V2_CURSOR_DEFAULT_LIMIT=25
V2_CURSOR_MAX_LIMIT=100
V2_CURSOR_TTL_SECONDS=86400
V2_CLIENT_REQUEST_ID_MAX_LENGTH=120
V2_IDEMPOTENCY_TTL_SECONDS=86400

AI_PROVIDER=disabled
AI_API_KEY=not_used_in_scaffold
